<canvas
  id="space-rocket-canvas"
  class="fixed inset-0 z-50 h-full w-full pointer-events-none"
  aria-hidden="true"
></canvas>
<button
  id="space-rocket-button"
  type="button"
  aria-label="Launch rocket"
  class="fixed bottom-4 left-24 z-50 cursor-pointer rounded-full border border-zinc-600/70 bg-zinc-900/70 px-3 py-1 font-mono text-xs tracking-wide text-zinc-300 backdrop-blur transition hover:border-zinc-400 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-300 disabled:cursor-default disabled:opacity-60 disabled:hover:border-zinc-600/70 disabled:hover:text-zinc-300"
>
  Launch
</button>
<span id="space-rocket-status" class="sr-only" aria-live="polite"></span>

<script>
  // A small Falcon-style rocket on a pad at the bottom left. Launch runs a
  // countdown, lifts off, separates the upper stage and flies the booster back
  // for a landing burn and touchdown on the pad.

  type State = "idle" | "countdown" | "ascent" | "return" | "landed" | "fade";

  type Particle = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    age: number;
    ttl: number;
    r0: number;
    r1: number;
    alpha: number;
  };

  const canvas = document.getElementById("space-rocket-canvas") as HTMLCanvasElement | null;
  const button = document.getElementById("space-rocket-button") as HTMLButtonElement | null;
  const status = document.getElementById("space-rocket-status");
  const ctx = canvas?.getContext("2d");

  if (canvas && button && status && ctx) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const G = 380; // gravity, px/s^2
    const BRAKE = 900; // landing burn deceleration, px/s^2
    const BODY = 70; // booster height in rocket units
    const STACK = 76; // booster + interstage

    let width = 0;
    let height = 0;
    let scale = 1;
    let padX = 44;
    let groundY = 0;

    let state: State = "idle";
    let tState = 0;
    let h = 0; // height of the booster base above the pad, px
    let v = 0; // vertical speed, px/s, up is positive
    let legs = 1; // 0 folded .. 1 deployed
    let throttle = 0;
    let burning = false;
    let attached = true; // upper stage still on the booster
    let stage2: { h: number; v: number } | null = null;
    let particles: Particle[] = [];
    let alpha = 1; // used by the reduced motion fade
    let shake = 0;
    let tilt = 0;
    let lastLabel = "";
    let raf = 0;
    let last = 0;

    const rand = (min: number, max: number) => min + Math.random() * (max - min);
    const clamp = (x: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, x));

    function setLabel(text: string, announce = false) {
      if (text === lastLabel) return;
      lastLabel = text;
      button!.textContent = text;
      if (announce) status!.textContent = text;
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas!.width = Math.round(width * dpr);
      canvas!.height = Math.round(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      scale = width < 640 ? 0.8 : 1;
      padX = 44;
      groundY = height - 22;
      if (state === "idle") draw();
    }

    // ---- drawing ---------------------------------------------------------

    function drawLegs(L: number) {
      ctx!.strokeStyle = "#c5c8cf";
      ctx!.lineWidth = 1.6;
      ctx!.lineCap = "round";
      for (const sign of [-1, 1]) {
        const footX = sign * (8 + 17 * L);
        const footY = -1 - (1 - L) * 3;
        ctx!.beginPath();
        ctx!.moveTo(sign * 6, -22);
        ctx!.lineTo(footX, footY);
        ctx!.stroke();
        ctx!.fillStyle = "#c5c8cf";
        ctx!.fillRect(footX - 2.5, footY - 0.5, 5, 1.6);
      }
    }

    function drawBooster(withUpper: boolean) {
      // engine skirt
      ctx!.fillStyle = "#2b2e35";
      ctx!.beginPath();
      ctx!.moveTo(-4, 0);
      ctx!.lineTo(4, 0);
      ctx!.lineTo(6, -6);
      ctx!.lineTo(-6, -6);
      ctx!.closePath();
      ctx!.fill();
      // first stage
      ctx!.fillStyle = "#e9ebef";
      ctx!.fillRect(-7, -BODY, 14, BODY - 6);
      ctx!.fillStyle = "rgba(0,0,0,0.12)";
      ctx!.fillRect(3, -BODY, 4, BODY - 6);
      // interstage
      ctx!.fillStyle = "#23262c";
      ctx!.fillRect(-7, -STACK, 14, STACK - BODY);
      // grid fins
      ctx!.fillStyle = "#3a3d45";
      ctx!.fillRect(-11, -73, 4, 7);
      ctx!.fillRect(7, -73, 4, 7);
      if (withUpper) {
        drawUpper(STACK);
      } else {
        // flat cap where the upper stage used to sit
        ctx!.fillStyle = "#3a3d45";
        ctx!.fillRect(-7, -STACK - 1, 14, 1.5);
      }
    }

    // second stage and fairing, with its base at local y = -base
    function drawUpper(base: number) {
      ctx!.fillStyle = "#e9ebef";
      ctx!.fillRect(-7, -base - 28, 14, 28);
      ctx!.fillStyle = "rgba(0,0,0,0.12)";
      ctx!.fillRect(3, -base - 28, 4, 28);
      ctx!.fillStyle = "#e9ebef";
      ctx!.beginPath();
      ctx!.moveTo(-7, -base - 28);
      ctx!.quadraticCurveTo(-6, -base - 42, 0, -base - 46);
      ctx!.quadraticCurveTo(6, -base - 42, 7, -base - 28);
      ctx!.closePath();
      ctx!.fill();
    }

    function drawFlame(power: number) {
      if (power <= 0.02) return;
      const len = power * (30 + Math.random() * 8);
      const wide = 3 + power * 2.5;
      const grad = ctx!.createLinearGradient(0, 0, 0, len);
      grad.addColorStop(0, "rgba(255,246,215,0.95)");
      grad.addColorStop(0.35, "rgba(255,170,60,0.75)");
      grad.addColorStop(1, "rgba(255,80,20,0)");
      ctx!.fillStyle = grad;
      ctx!.beginPath();
      ctx!.moveTo(-wide, 0);
      ctx!.quadraticCurveTo(-wide - 1, len * 0.5, 0, len);
      ctx!.quadraticCurveTo(wide + 1, len * 0.5, wide, 0);
      ctx!.closePath();
      ctx!.fill();
      ctx!.fillStyle = `rgba(255,190,110,${0.14 * power})`;
      ctx!.beginPath();
      ctx!.arc(0, 4, 12 * power + 4, 0, Math.PI * 2);
      ctx!.fill();
    }

    function drawStage2(base: number) {
      ctx!.save();
      ctx!.translate(padX, base);
      ctx!.scale(scale, scale);
      drawUpper(0);
      ctx!.fillStyle = "#2b2e35";
      ctx!.fillRect(-4, -3, 8, 3);
      drawFlame(0.45);
      ctx!.restore();
    }

    function draw() {
      ctx!.clearRect(0, 0, width, height);

      // pad
      const padW = 78 * scale;
      ctx!.fillStyle = "#23262c";
      ctx!.fillRect(padX - padW / 2, groundY, padW, 5);
      ctx!.fillStyle = "rgba(255,255,255,0.08)";
      ctx!.fillRect(padX - padW / 2, groundY, padW, 1);

      // smoke
      for (const p of particles) {
        const k = p.age / p.ttl;
        const r = p.r0 + (p.r1 - p.r0) * k;
        ctx!.fillStyle = `rgba(225,227,232,${p.alpha * Math.pow(1 - k, 1.6)})`;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, r, 0, Math.PI * 2);
        ctx!.fill();
      }

      if (stage2) drawStage2(groundY - stage2.h);

      ctx!.save();
      ctx!.globalAlpha = alpha;
      ctx!.translate(padX + shake, groundY - h);
      ctx!.rotate(tilt);
      ctx!.scale(scale, scale);
      drawLegs(legs);
      drawBooster(attached);
      drawFlame(throttle);
      ctx!.restore();
    }

    // ---- simulation -------------------------------------------------------

    function emitSmoke(dt: number) {
      const near = h < 130 * scale;
      const n = Math.round(dt * 110 * throttle);
      const x = padX + shake;
      const y = groundY - h + 4 * scale;
      for (let i = 0; i < n && particles.length < 420; i++) {
        if (near) {
          const dir = Math.random() < 0.5 ? -1 : 1;
          particles.push({
            x: x + rand(-4, 4),
            y: y - rand(0, 3),
            vx: dir * rand(40, 170),
            vy: rand(-14, 4),
            age: 0,
            ttl: rand(0.9, 1.6),
            r0: 4,
            r1: rand(12, 20) * scale,
            alpha: 0.4,
          });
        } else {
          particles.push({
            x: x + rand(-3, 3),
            y: y + rand(0, 8),
            vx: rand(-16, 16),
            vy: rand(10, 50),
            age: 0,
            ttl: rand(0.8, 1.3),
            r0: 2.5,
            r1: rand(6, 10) * scale,
            alpha: 0.28,
          });
        }
      }
    }

    function dustBurst() {
      for (let i = 0; i < 16; i++) {
        const dir = i % 2 === 0 ? -1 : 1;
        particles.push({
          x: padX + rand(-10, 10),
          y: groundY - rand(0, 3),
          vx: dir * rand(30, 120),
          vy: rand(-12, 2),
          age: 0,
          ttl: rand(0.8, 1.4),
          r0: 3,
          r1: rand(10, 16) * scale,
          alpha: 0.35,
        });
      }
    }

    function stepParticles(dt: number) {
      for (const p of particles) {
        p.age += dt;
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.vx *= 1 - Math.min(dt * 1.2, 1);
      }
      particles = particles.filter((p) => p.age < p.ttl);
    }

    function step(dt: number) {
      tState += dt;
      shake = 0;
      tilt = 0;

      switch (state) {
        case "countdown": {
          const remaining = 3 - tState;
          setLabel(`T-${Math.max(1, Math.ceil(remaining))}`, true);
          throttle = remaining < 1 ? (1 - remaining) * 0.5 : 0;
          if (remaining < 1.5) shake = (Math.random() - 0.5) * (1.5 - remaining) * 1.4;
          if (remaining <= 0) {
            state = "ascent";
            tState = 0;
            v = 0;
            setLabel("Liftoff", true);
          }
          break;
        }
        case "ascent": {
          v += (120 + 520 * tState) * dt;
          h += v * dt;
          throttle = 1;
          legs = 1 - clamp((tState - 0.25) / 0.6, 0, 1);
          // separate once the booster's coast would peak at about 72% of the screen
          if (h + (v * v) / (2 * G) >= 0.72 * height) {
            stage2 = { h: h + STACK * scale, v };
            attached = false;
            throttle = 0;
            state = "return";
            tState = 0;
            burning = false;
            setLabel("Stage sep", true);
          }
          break;
        }
        case "return": {
          if (burning) {
            const dist = Math.max(h, 0.5);
            const need = Math.min((v * v) / (2 * dist), BRAKE * 1.3);
            v += need * dt;
            if (v > -45) v = -45;
            throttle = clamp(need / BRAKE, 0.35, 1);
          } else {
            v -= G * dt;
            throttle = 0;
            if (v < 0 && (v * v) / (2 * Math.max(h, 0.5)) >= BRAKE * 0.92) {
              burning = true;
              setLabel("Landing burn", true);
            }
          }
          h += v * dt;
          if (v < 0 && h < 340) legs = Math.min(1, legs + dt / 0.45);
          if (v < 0) tilt = 0.07 * Math.sin(tState * 2.2) * clamp(h / (0.5 * height), 0, 1);
          if (h <= 0) {
            h = 0;
            v = 0;
            throttle = 0;
            burning = false;
            state = "landed";
            tState = 0;
            dustBurst();
            setLabel("Landed", true);
          }
          break;
        }
        case "landed":
          throttle = 0;
          if (tState >= 1.4) finish();
          break;
        case "fade": {
          // reduced motion: no flight, just fade out and back in
          if (tState < 0.4) alpha = 1 - tState / 0.4;
          else if (tState < 1.4) alpha = 0;
          else if (tState < 2) alpha = (tState - 1.4) / 0.6;
          else finish();
          break;
        }
      }

      if (stage2) {
        stage2.v += 400 * dt;
        stage2.h += stage2.v * dt;
        if (stage2.h > height + 260) stage2 = null;
      }

      if (throttle > 0 && state !== "fade") emitSmoke(dt);
      stepParticles(dt);
    }

    function finish() {
      state = "idle";
      h = 0;
      v = 0;
      legs = 1;
      throttle = 0;
      attached = true;
      stage2 = null;
      alpha = 1;
      shake = 0;
      tilt = 0;
      setLabel("Launch");
      button!.disabled = false;
      status!.textContent = "";
    }

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      const t = now / 1000;
      const dt = Math.min(t - last, 0.033);
      last = t;
      if (dt <= 0) return;
      step(dt);
      draw();
      if (state === "idle" && particles.length === 0) {
        cancelAnimationFrame(raf);
        raf = 0;
        draw();
      }
    }

    function launch() {
      if (state !== "idle") return;
      button!.disabled = true;
      tState = 0;
      particles = [];
      if (reduceMotion.matches) {
        state = "fade";
        setLabel("Launched", true);
      } else {
        state = "countdown";
        setLabel("T-3", true);
      }
      last = performance.now() / 1000;
      if (!raf) raf = requestAnimationFrame(frame);
    }

    button.addEventListener("click", launch);
    window.addEventListener("resize", resize);
    resize();
  }
</script>
