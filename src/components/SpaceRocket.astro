<canvas
  id="space-rocket-canvas"
  class="fixed inset-0 z-50 h-full w-full pointer-events-none"
  aria-hidden="true"
></canvas>
<button
  id="space-rocket-button"
  type="button"
  aria-label="Launch rocket"
  class="fixed bottom-4 left-24 z-50 cursor-pointer rounded-full border border-zinc-600/70 bg-zinc-900/70 px-3 py-1 font-mono text-xs tracking-wide text-zinc-300 backdrop-blur transition hover:border-zinc-400 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-300 disabled:cursor-default disabled:opacity-60 disabled:hover:border-zinc-600/70 disabled:hover:text-zinc-300"
>
  Launch
</button>
<span id="space-rocket-status" class="sr-only" aria-live="polite"></span>

<script>
  // A small Falcon-style rocket on a pad at the bottom left. Launch runs a
  // countdown and lifts off on a parabolic arc toward the upper right. The upper
  // stage flies away; the booster flips, burns and lands on the platform at the
  // bottom right. The button then becomes Reset, which puts a new rocket on the
  // launch pad. Every launch picks a slightly different arc and landing spot.

  type State = "idle" | "countdown" | "ascent" | "return" | "landed" | "fade";

  type Particle = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    age: number;
    ttl: number;
    r0: number;
    r1: number;
    alpha: number;
  };

  type Stage2 = { x: number; h: number; vx: number; vu: number };

  const canvas = document.getElementById("space-rocket-canvas") as HTMLCanvasElement | null;
  const button = document.getElementById("space-rocket-button") as HTMLButtonElement | null;
  const status = document.getElementById("space-rocket-status");
  const ctx = canvas?.getContext("2d");

  if (canvas && button && status && ctx) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const G = 240; // gravity, px/s^2 (lower is slower and floatier)
    const BRAKE = 620; // landing burn deceleration, px/s^2
    const KP = 7; // attitude controller gains and torque limit (rad/s^2)
    const KD = 4.6;
    const TORQUE = 2.0;
    const HOLD = 1.1; // seconds the booster holds its attitude after separation
    const BODY = 70; // booster height in rocket units
    const STACK = 76; // booster + interstage

    let width = 0;
    let height = 0;
    let scale = 1;
    let padX = 44; // launch pad centre
    let groundY = 0;
    let platW = 170; // landing platform width
    let platCX = 0; // landing platform centre
    let landOffset = 0; // landing spot relative to the platform centre

    let state: State = "idle";
    let tState = 0;

    // booster, x is the centre of its base, h is the height of the base above the ground
    let rx = 44;
    let rh = 0;
    let ang = 0; // radians clockwise from vertical
    let legs = 1; // 0 folded .. 1 deployed
    let throttle = 0;
    let attached = true; // upper stage still on the booster
    let stage2: Stage2 | null = null;
    let particles: Particle[] = [];
    let alpha = 1;
    let shake = 0;

    // the current flight
    let fl = { x0: 0, lx: 0, vx: 0, vy0: 0, hb: 0, tp: 1.7 };
    let tF = 0; // time since liftoff
    let tau = 0; // position along the parabola, in seconds
    let vu = 0; // vertical speed, up is positive
    let sepAng = 0;
    let burning = false;
    let hb0 = 1;
    let dx0 = 0;
    let fadeDest: "pad" | "platform" = "pad";
    let fadeMoved = false;
    let omega = 0; // angular speed, rad/s clockwise
    let gimbal = 0; // engine tilt used to keep the booster balanced
    let tSep = 0; // time since stage separation
    let rcsAcc = 0;

    let lastLabel = "";
    let raf = 0;
    let last = 0;

    const rand = (min: number, max: number) => min + Math.random() * (max - min);
    const clamp = (x: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, x));
    const smooth = (x: number) => {
      const k = clamp(x, 0, 1);
      return k * k * (3 - 2 * k);
    };

    function setLabel(text: string, aria?: string, announce = false) {
      if (text === lastLabel) return;
      lastLabel = text;
      button!.textContent = text;
      if (aria) button!.setAttribute("aria-label", aria);
      else button!.removeAttribute("aria-label");
      if (announce) status!.textContent = text;
    }

    function landingX() {
      return platCX + landOffset;
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas!.width = Math.round(width * dpr);
      canvas!.height = Math.round(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      scale = width < 640 ? 0.8 : 1;
      padX = 44;
      groundY = height - 22;
      platW = 170 * scale;
      platCX = width - platW / 2 - 20;
      if (state === "idle") rx = padX;
      if (state === "landed") rx = landingX();
      if (state === "idle" || state === "landed") draw();
    }

    // ---- drawing ---------------------------------------------------------

    function drawLegs(L: number) {
      ctx!.strokeStyle = "#c5c8cf";
      ctx!.lineWidth = 1.6;
      ctx!.lineCap = "round";
      for (const sign of [-1, 1]) {
        const footX = sign * (8 + 17 * L);
        const footY = -1 - (1 - L) * 3;
        ctx!.beginPath();
        ctx!.moveTo(sign * 6, -22);
        ctx!.lineTo(footX, footY);
        ctx!.stroke();
        ctx!.fillStyle = "#c5c8cf";
        ctx!.fillRect(footX - 2.5, footY - 0.5, 5, 1.6);
      }
    }

    function drawBooster(withUpper: boolean) {
      // engine skirt
      ctx!.fillStyle = "#2b2e35";
      ctx!.beginPath();
      ctx!.moveTo(-4, 0);
      ctx!.lineTo(4, 0);
      ctx!.lineTo(6, -6);
      ctx!.lineTo(-6, -6);
      ctx!.closePath();
      ctx!.fill();
      // first stage
      ctx!.fillStyle = "#e9ebef";
      ctx!.fillRect(-7, -BODY, 14, BODY - 6);
      ctx!.fillStyle = "rgba(0,0,0,0.12)";
      ctx!.fillRect(3, -BODY, 4, BODY - 6);
      // interstage
      ctx!.fillStyle = "#23262c";
      ctx!.fillRect(-7, -STACK, 14, STACK - BODY);
      // grid fins
      ctx!.fillStyle = "#3a3d45";
      ctx!.fillRect(-11, -73, 4, 7);
      ctx!.fillRect(7, -73, 4, 7);
      if (withUpper) {
        drawUpper(STACK);
      } else {
        // flat cap where the upper stage used to sit
        ctx!.fillStyle = "#3a3d45";
        ctx!.fillRect(-7, -STACK - 1, 14, 1.5);
      }
    }

    // second stage and fairing, with its base at local y = -base
    function drawUpper(base: number) {
      ctx!.fillStyle = "#e9ebef";
      ctx!.fillRect(-7, -base - 28, 14, 28);
      ctx!.fillStyle = "rgba(0,0,0,0.12)";
      ctx!.fillRect(3, -base - 28, 4, 28);
      ctx!.fillStyle = "#e9ebef";
      ctx!.beginPath();
      ctx!.moveTo(-7, -base - 28);
      ctx!.quadraticCurveTo(-6, -base - 42, 0, -base - 46);
      ctx!.quadraticCurveTo(6, -base - 42, 7, -base - 28);
      ctx!.closePath();
      ctx!.fill();
    }

    function drawFlame(power: number) {
      if (power <= 0.02) return;
      const len = power * (30 + Math.random() * 8);
      const wide = 3 + power * 2.5;
      const grad = ctx!.createLinearGradient(0, 0, 0, len);
      grad.addColorStop(0, "rgba(255,246,215,0.95)");
      grad.addColorStop(0.35, "rgba(255,170,60,0.75)");
      grad.addColorStop(1, "rgba(255,80,20,0)");
      ctx!.fillStyle = grad;
      ctx!.beginPath();
      ctx!.moveTo(-wide, 0);
      ctx!.quadraticCurveTo(-wide - 1, len * 0.5, 0, len);
      ctx!.quadraticCurveTo(wide + 1, len * 0.5, wide, 0);
      ctx!.closePath();
      ctx!.fill();
      ctx!.fillStyle = `rgba(255,190,110,${0.14 * power})`;
      ctx!.beginPath();
      ctx!.arc(0, 4, 12 * power + 4, 0, Math.PI * 2);
      ctx!.fill();
    }

    function drawPlatform(cx: number, w: number, light: boolean) {
      ctx!.fillStyle = "#23262c";
      ctx!.fillRect(cx - w / 2, groundY, w, 5);
      ctx!.fillStyle = "rgba(255,255,255,0.08)";
      ctx!.fillRect(cx - w / 2, groundY, w, 1);
      if (light) {
        // a few edge markers so the landing area reads as a target
        ctx!.fillStyle = "rgba(255,255,255,0.22)";
        for (const f of [-0.42, -0.14, 0.14, 0.42]) {
          ctx!.fillRect(cx + f * w - 4, groundY + 2, 8, 1.4);
        }
      }
    }

    function draw() {
      ctx!.clearRect(0, 0, width, height);

      drawPlatform(padX, 78 * scale, false);
      drawPlatform(platCX, platW, true);

      // smoke
      for (const p of particles) {
        const k = p.age / p.ttl;
        const r = p.r0 + (p.r1 - p.r0) * k;
        ctx!.fillStyle = `rgba(225,227,232,${p.alpha * Math.pow(1 - k, 1.6)})`;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, r, 0, Math.PI * 2);
        ctx!.fill();
      }

      if (stage2) {
        ctx!.save();
        ctx!.translate(stage2.x, groundY - stage2.h);
        ctx!.rotate(Math.atan2(stage2.vx, stage2.vu));
        ctx!.scale(scale, scale);
        drawUpper(0);
        ctx!.fillStyle = "#2b2e35";
        ctx!.fillRect(-4, -3, 8, 3);
        drawFlame(0.45);
        ctx!.restore();
      }

      ctx!.save();
      ctx!.globalAlpha = alpha;
      ctx!.translate(rx + shake, groundY - rh);
      ctx!.rotate(ang);
      ctx!.scale(scale, scale);
      drawLegs(legs);
      drawBooster(attached);
      ctx!.rotate(gimbal);
      drawFlame(throttle);
      ctx!.restore();
    }

    // ---- simulation -------------------------------------------------------

    function emitSmoke(dt: number) {
      const near = rh < 130 * scale;
      const n = Math.round(dt * 110 * throttle);
      // exhaust leaves opposite to where the nose points
      const ex = -Math.sin(ang);
      const ey = Math.cos(ang);
      const x = rx + shake + ex * 4 * scale;
      const y = groundY - rh + ey * 4 * scale;
      for (let i = 0; i < n && particles.length < 420; i++) {
        if (near) {
          const dir = Math.random() < 0.5 ? -1 : 1;
          particles.push({
            x: x + rand(-4, 4),
            y: y - rand(0, 3),
            vx: dir * rand(40, 170),
            vy: rand(-14, 4),
            age: 0,
            ttl: rand(0.9, 1.6),
            r0: 4,
            r1: rand(12, 20) * scale,
            alpha: 0.4,
          });
        } else {
          const push = rand(20, 70);
          particles.push({
            x: x + rand(-3, 3),
            y: y + rand(0, 4),
            vx: ex * push + rand(-14, 14),
            vy: ey * push + rand(-14, 14),
            age: 0,
            ttl: rand(0.8, 1.3),
            r0: 2.5,
            r1: rand(6, 10) * scale,
            alpha: 0.28,
          });
        }
      }
    }

    function dustBurst(x: number) {
      for (let i = 0; i < 16; i++) {
        const dir = i % 2 === 0 ? -1 : 1;
        particles.push({
          x: x + rand(-10, 10),
          y: groundY - rand(0, 3),
          vx: dir * rand(30, 120),
          vy: rand(-12, 2),
          age: 0,
          ttl: rand(0.8, 1.4),
          r0: 3,
          r1: rand(10, 16) * scale,
          alpha: 0.35,
        });
      }
    }

    function stepParticles(dt: number) {
      for (const p of particles) {
        p.age += dt;
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.vx *= 1 - Math.min(dt * 1.2, 1);
      }
      particles = particles.filter((p) => p.age < p.ttl);
    }

    // Pick this launch's arc. The booster follows a parabola from the launch pad
    // that comes down above the landing spot, then makes a vertical landing burn.
    function planFlight() {
      const room = groundY - 40 - 100 * scale; // room above the ground for the apex
      const apex = room * rand(0.62, 0.98);
      const hb = Math.min(clamp(0.24 * height, 90, 230), apex * 0.45);
      landOffset = rand(-0.32, 0.32) * platW;
      const lx = landingX();
      const vy0 = Math.sqrt(2 * G * apex);
      const flightTime = (2 * vy0) / G;
      const tBurn = Math.sqrt((2 * (apex - hb)) / G); // time from apex to burn start
      // horizontal speed such that the burn (where sideways speed also dies off)
      // ends exactly on the landing spot
      const vx = (lx - padX) / (flightTime / 2 + tBurn + hb / (2 * G * tBurn));
      fl = { x0: padX, lx, vx, vy0, hb, tp: rand(2.0, 2.5) };
    }

    function pathAt(t: number) {
      rx = fl.x0 + fl.vx * t;
      rh = fl.vy0 * t - 0.5 * G * t * t;
      vu = fl.vy0 - G * t;
    }

    function touchdown() {
      rh = 0;
      rx = fl.lx;
      ang = 0;
      omega = 0;
      gimbal = 0;
      vu = 0;
      throttle = 0;
      burning = false;
      state = "landed";
      tState = 0;
      dustBurst(rx);
      legs = 1;
      button!.disabled = false;
      setLabel("Reset", "Reset rocket");
      status!.textContent = "Landed";
    }

    function startFade(dest: "pad" | "platform") {
      state = "fade";
      fadeDest = dest;
      fadeMoved = false;
      tState = 0;
      button!.disabled = true;
      if (!raf) {
        last = performance.now() / 1000;
        raf = requestAnimationFrame(frame);
      }
    }

    // Puffs of cold gas from the side of the nose. Gas leaving to the left turns
    // the booster clockwise and the other way around.
    function emitRcs(cmd: number, dt: number) {
      if (Math.abs(cmd) < 0.25) return;
      rcsAcc += dt * 50 * Math.abs(cmd);
      const dir = cmd > 0 ? -1 : 1; // side the gas leaves toward
      const px = Math.cos(ang); // unit vector pointing out of the right side
      const py = Math.sin(ang);
      const nx = Math.sin(ang); // unit vector along the nose
      const ny = -Math.cos(ang);
      const ox = rx + nx * (STACK - 4) * scale + px * dir * 8 * scale;
      const oy = groundY - rh + ny * (STACK - 4) * scale + py * dir * 8 * scale;
      while (rcsAcc >= 1 && particles.length < 420) {
        rcsAcc -= 1;
        const out = rand(80, 130);
        particles.push({
          x: ox,
          y: oy,
          vx: px * dir * out + rand(-12, 12),
          vy: py * dir * out + rand(-12, 12),
          age: 0,
          ttl: rand(0.3, 0.5),
          r0: 1.4,
          r1: 4.5 * scale,
          alpha: 0.75,
        });
      }
    }

    // Keep the booster pointed at `target` with a limited-torque controller.
    // Before the landing burn it fires cold gas thrusters; during the burn it
    // tilts the engine instead. `noise` is a small disturbance it has to fight.
    function attitude(dt: number, target: number, noise: number, engine: boolean) {
      const want = clamp(KP * (target - ang) - KD * omega, -TORQUE, TORQUE);
      const disturbance = noise * (Math.sin(tState * 2.1 + 1.3) + 0.6 * Math.sin(tState * 5.3));
      omega += (want + disturbance) * dt;
      ang += omega * dt;
      const cmd = want / TORQUE;
      if (engine) {
        gimbal = -cmd * 0.45;
      } else {
        gimbal = 0;
        emitRcs(cmd, dt);
      }
    }

    function step(dt: number) {
      tState += dt;
      shake = 0;

      switch (state) {
        case "countdown": {
          const remaining = 3 - tState;
          setLabel(`T-${Math.max(1, Math.ceil(remaining))}`, undefined, true);
          throttle = remaining < 1 ? (1 - remaining) * 0.5 : 0;
          if (remaining < 1.5) shake = (Math.random() - 0.5) * (1.5 - remaining) * 1.4;
          if (remaining <= 0) {
            state = "ascent";
            tState = 0;
            tF = 0;
            tau = 0;
            setLabel("Liftoff", undefined, true);
          }
          break;
        }
        case "ascent": {
          tF += dt;
          // speed ramps up from rest, then matches the free parabola at separation
          tau = tF < fl.tp ? (tF * tF) / (2 * fl.tp) : fl.tp / 2 + (tF - fl.tp);
          pathAt(tau);
          throttle = 1;
          legs = 1 - clamp((tF - 0.25) / 0.6, 0, 1);
          ang = Math.atan2(fl.vx, vu) * smooth(tF / 1.0);
          if (tF >= fl.tp) {
            sepAng = ang;
            stage2 = {
              x: rx + Math.sin(ang) * STACK * scale,
              h: rh + Math.cos(ang) * STACK * scale,
              vx: fl.vx,
              vu,
            };
            attached = false;
            throttle = 0;
            burning = false;
            omega = 0;
            tSep = 0;
            state = "return";
            tState = 0;
            setLabel("Stage sep", undefined, true);
          }
          break;
        }
        case "return": {
          if (!burning) {
            tau += dt;
            tSep += dt;
            pathAt(tau);
            throttle = 0;
            // Hold the attitude after separation (the nose keeps pointing where it
            // was while the path bends over), then flip to engines-first with
            // cold gas thrusters at the nose. Nothing leans early.
            const target = tSep < HOLD ? sepAng : -Math.atan2(fl.vx, 250 + Math.max(-vu, 0));
            attitude(dt, target, 0.18, false);
            if (vu < 0 && rh < fl.hb * 1.9) legs = Math.min(1, legs + dt / 0.7);
            if (vu < 0 && rh <= fl.hb) {
              burning = true;
              hb0 = Math.max(rh, 1);
              dx0 = fl.lx - rx;
              setLabel("Landing burn", undefined, true);
            }
          } else {
            const need = Math.min((vu * vu) / (2 * Math.max(rh, 0.5)), BRAKE * 1.3);
            vu += need * dt;
            if (vu > -30) vu = -30;
            throttle = clamp(need / BRAKE, 0.35, 1);
            rh += vu * dt;
            // sideways speed dies off smoothly as the booster comes down
            const f = clamp(rh / hb0, 0, 1);
            const nx = fl.lx - dx0 * f * f;
            const vxNow = (nx - rx) / dt;
            rx = nx;
            // the engine gimbals to keep the booster balanced on its way down;
            // the wobble fades out just before touchdown
            attitude(dt, -Math.atan2(vxNow, -vu), 0.5 * clamp(rh / 60, 0, 1), true);
            legs = Math.min(1, legs + dt / 0.7);
            if (rh <= 0) touchdown();
          }
          break;
        }
        case "fade": {
          // reduced motion launch, and Reset: fade out, move, fade back in
          if (tState < 0.4) {
            alpha = 1 - tState / 0.4;
          } else if (tState < 0.9) {
            if (!fadeMoved) {
              fadeMoved = true;
              particles = [];
              stage2 = null;
              attached = fadeDest === "pad";
              legs = 1;
              ang = 0;
              omega = 0;
              gimbal = 0;
              rh = 0;
              rx = fadeDest === "pad" ? padX : landingX();
            }
            alpha = (tState - 0.4) / 0.5;
          } else {
            alpha = 1;
            if (fadeDest === "pad") {
              state = "idle";
              setLabel("Launch", "Launch rocket");
              status!.textContent = "";
            } else {
              state = "landed";
              setLabel("Reset", "Reset rocket");
              status!.textContent = "Landed";
            }
            button!.disabled = false;
          }
          break;
        }
      }

      if (stage2) {
        const speed = Math.hypot(stage2.vx, stage2.vu) || 1;
        stage2.vx += (stage2.vx / speed) * 260 * dt;
        stage2.vu += (stage2.vu / speed) * 260 * dt;
        stage2.x += stage2.vx * dt;
        stage2.h += stage2.vu * dt;
        if (stage2.x > width + 200 || stage2.h > height + 200) stage2 = null;
      }

      if (throttle > 0 && state !== "fade") emitSmoke(dt);
      stepParticles(dt);
    }

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      const t = now / 1000;
      const dt = Math.min(t - last, 0.033);
      last = t;
      if (dt <= 0) return;
      step(dt);
      draw();
      if ((state === "idle" || state === "landed") && particles.length === 0) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }

    function launch() {
      if (state !== "idle") return;
      button!.disabled = true;
      tState = 0;
      particles = [];
      planFlight();
      if (reduceMotion.matches) {
        setLabel("Launched", undefined, true);
        startFade("platform");
        return;
      }
      attached = true;
      stage2 = null;
      ang = 0;
      omega = 0;
      gimbal = 0;
      state = "countdown";
      setLabel("T-3", undefined, true);
      last = performance.now() / 1000;
      if (!raf) raf = requestAnimationFrame(frame);
    }

    button.addEventListener("click", () => {
      if (state === "idle") launch();
      else if (state === "landed") startFade("pad");
    });
    window.addEventListener("resize", resize);
    resize();
  }
</script>
